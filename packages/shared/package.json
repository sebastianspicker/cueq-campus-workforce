{
  "name": "@cueq/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, types, and utilities for cueq",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "CUEQ_INCLUDE_SPECIALIZED_TESTS=1 vitest run --coverage",
    "test:integration": "vitest run --config vitest.suites.config.ts src/__tests__/shared.integration.test.ts",
    "test:acceptance": "vitest run --config vitest.suites.config.ts src/__tests__/shared.acceptance.test.ts",
    "test:compliance": "vitest run --config vitest.suites.config.ts src/__tests__/shared.compliance.test.ts",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
