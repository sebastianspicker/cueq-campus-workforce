{
  "name": "@cueq/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema and database client for cueq",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:phase2": "node prisma/seed-phase2.mjs seed",
    "db:reset:phase2": "node prisma/seed-phase2.mjs reset",
    "db:seed:phase3": "node prisma/seed-phase3.mjs seed",
    "db:reset:phase3": "node prisma/seed-phase3.mjs reset",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "prisma": "6.19.2"
  }
}
