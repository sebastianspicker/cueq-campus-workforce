{
  "valid": [
    {
      "name": "bom-crlf",
      "csv": "\ufeffexternalId,email,firstName,lastName\r\nemp01,one@example.test,One,Person\r\n",
      "expected": { "externalId": "emp01", "email": "one@example.test" }
    },
    {
      "name": "quoted-comma-and-escaped-quote",
      "csv": "externalId,email,firstName,lastName\nemp02,two@example.test,\"Ada, A.\",\"O\"\"Neil\"",
      "expected": { "firstName": "Ada, A.", "lastName": "O\"Neil" }
    },
    {
      "name": "embedded-newline",
      "csv": "externalId,email,firstName,lastName\nemp03,three@example.test,\"Line\nBreak\",Person",
      "expected": { "firstName": "Line\nBreak" }
    }
  ],
  "invalid": [
    {
      "name": "duplicate-header",
      "csv": "externalId,email,email\nemp01,a@example.test,b@example.test",
      "error": "duplicate header names are not allowed"
    },
    {
      "name": "empty-header",
      "csv": "externalId,,email\nemp01,ignored,a@example.test",
      "error": "header names must be non-empty"
    },
    {
      "name": "unmatched-quote",
      "csv": "externalId,email\n\"emp01,a@example.test",
      "error": "unmatched quote in input"
    }
  ]
}
