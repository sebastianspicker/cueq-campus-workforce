{
  "name": "cueq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source alpha for time tracking, absence management, and shift planning in a German university context",
  "license": "MIT",
  "author": "Sebastian J. Spicker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianspicker/cueq.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianspicker/cueq/issues"
  },
  "homepage": "https://github.com/sebastianspicker/cueq#readme",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "toolchain:verify": "node ./scripts/verify-typescript-toolchain.mjs",
    "typecheck": "node ./scripts/verify-typescript-toolchain.mjs && turbo run typecheck",
    "test": "turbo run test",
    "backfill:leave-adjustments": "node ./scripts/backfill-leave-adjustments.mjs",
    "backfill:workflow-fields": "node ./scripts/backfill-workflow-fields.mjs",
    "migrate:webhook-envelopes": "bash ./scripts/migrate-webhook-secrets.sh",
    "docs:links": "node ./scripts/check-doc-links.mjs",
    "knip": "knip --cache",
    "knip:production": "knip --strict --cache",
    "hygiene:code": "pnpm run knip && pnpm run knip:production",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "schemas": "bash ./scripts/schemas.sh",
    "generate": "bash ./scripts/generate.sh",
    "openapi:check": "bash ./scripts/openapi-check.sh",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "husky": "9.1.7",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "9.39.3",
    "knip": "6.25.0",
    "prettier": "3.8.1",
    "turbo": "2.9.14",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/cli>typescript": "npm:@typescript/typescript6@6.0.2",
      "effect": "3.21.4",
      "lodash": "4.18.1",
      "multer": "2.2.0",
      "path-to-regexp": "8.4.2",
      "file-type": "21.3.4",
      "flatted": "3.4.2",
      "picomatch": "4.0.4",
      "defu": "6.1.7",
      "body-parser": "2.3.0",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "qs": "6.15.3",
      "@angular-devkit/core>ajv": "8.18.0",
      "ajv-formats>ajv": "8.18.0",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "sharp": "0.35.0",
      "undici": "7.29.0",
      "vite": "7.3.5",
      "minimatch@3.1.5>brace-expansion": "1.1.18",
      "minimatch@9.0.9>brace-expansion": "2.1.4",
      "minimatch@10.2.4>brace-expansion": "5.0.9"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "9.15.0"
  }
}
