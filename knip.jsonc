{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev.mjs!",
        "scripts/backup-restore-verify.mjs!",
        "scripts/generate-domain-schema-types.mjs",
        "scripts/generate-db-schema-doc.mjs",
        "scripts/hr-import.mjs!",
        "scripts/validate-schemas.mjs",
        "scripts/**/*.sh",
        "scripts/shims/*",
      ],
      "project": ["scripts/**/*.{mjs,cjs,js,ts}", "*.{mjs,cjs,js,ts}"],
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/commands/*.ts!", "src/**/*.test.ts", "vitest*.config.ts"],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/test-utils/**!",
        "src/**/*.test.ts",
        "vitest*.config.ts",
      ],
    },
    "apps/web": {
      "entry": ["src/app/**/{page,layout,loading,error,not-found,route}.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/*.{test,spec}.{ts,tsx}!", "*.{ts,tsx}"],
    },
    "packages/domain": {
      "entry": ["src/index.ts!", "src/**/*.test.ts", "src/audit/build-audit-entry.typecheck.ts"],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/**/__tests__/**!",
        "!src/**/*.typecheck.ts!",
        "src/**/*.test.ts",
        "src/**/*.typecheck.ts",
      ],
    },
    "packages/database": {
      "entry": ["src/index.ts!", "prisma/seed-*.mjs!", "scripts/*.mjs!"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "prisma/*.mjs", "scripts/*.mjs"],
    },
    "packages/policy": {
      "entry": ["src/index.ts!", "src/**/*.test.ts", "vitest*.config.ts"],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/**/__tests__/**!",
        "src/**/*.test.ts",
        "vitest*.config.ts",
      ],
    },
    "packages/contracts": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": [
        "src/**/*.ts!",
        "!src/**/*.test.ts!",
        "!src/**/__tests__/**!",
        "src/**/*.test.ts",
      ],
    },
  },
}
