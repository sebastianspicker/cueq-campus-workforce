{
  "name": "@cueq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "cueq NestJS API server",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "openapi:export": "node dist/commands/export-openapi.js",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:compliance": "vitest run --config vitest.compliance.config.ts",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "dependencies": {
    "@cueq/core": "workspace:*",
    "@cueq/database": "workspace:*",
    "@cueq/policy": "workspace:*",
    "@cueq/shared": "workspace:*",
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/swagger": "11.2.6",
    "helmet": "8.1.0",
    "jose": "6.2.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.18",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "6.0.3",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "supertest": "7.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
