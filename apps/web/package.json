{
  "name": "@cueq/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "cueq Next.js web frontend",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname ${CUEQ_DEV_HOST:-127.0.0.1} --port 3000",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "dependencies": {
    "@cueq/shared": "workspace:*",
    "next": "15.5.21",
    "next-intl": "4.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
